#!/bin/bash
set -euo pipefail

systemctl stop ecs || true
volume_serial="$(echo '${volume_id}' | tr -d '-')"
device=""
for attempt in $(seq 1 120); do
  device="$(lsblk -dpno NAME,SERIAL | awk -v serial="$volume_serial" '$2 == serial { print $1; exit }')"
  if [ -z "$device" ] && [ -b /dev/xvdf ]; then
    device=/dev/xvdf
  fi
  if [ -n "$device" ] && [ -b "$device" ]; then
    break
  fi
  sleep 5
done
test -n "$device"
test -b "$device"

filesystem="$(blkid -o value -s TYPE "$device" || true)"
if [ -z "$filesystem" ]; then
  # Never format a disk with an unknown signature or a partition table.
  if [ -n "$(wipefs --no-act --noheadings "$device")" ]; then
    echo "Refusing to format a disk with existing signatures" >&2
    exit 1
  fi
  mkfs.ext4 "$device"
elif [ "$filesystem" != "ext4" ]; then
  echo "Expected an ext4 GitLab data volume" >&2
  exit 1
fi

mkdir -p /srv/gitlab
uuid="$(blkid -o value -s UUID "$device")"
echo "UUID=$uuid /srv/gitlab ext4 defaults 0 2" >> /etc/fstab
mount /srv/gitlab
mkdir -p /srv/gitlab/config /srv/gitlab/logs /srv/gitlab/data
chmod 0700 /srv/gitlab/config

cat > /etc/ecs/ecs.config <<'CONFIG'
ECS_CLUSTER=${cluster_name}
ECS_ENABLE_TASK_IAM_ROLE=true
ECS_AWSVPC_BLOCK_IMDS=true
ECS_ENABLE_TASK_IAM_ROLE_NETWORK_HOST=false
ECS_ENABLE_AWSLOGS_EXECUTIONROLE_OVERRIDE=true
CONFIG

# Bridge-mode containers must not obtain the EC2 instance profile credentials.
systemctl start docker
iptables -I DOCKER-USER -d 169.254.169.254/32 -j DROP
mkdir -p /etc/systemd/system/ecs.service.d
cat > /etc/systemd/system/ecs.service.d/gitlab.conf <<'UNIT'
[Unit]
RequiresMountsFor=/srv/gitlab
After=cloud-final.service

[Service]
ExecStartPre=/bin/sh -c '/usr/sbin/iptables -C DOCKER-USER -d 169.254.169.254/32 -j DROP || /usr/sbin/iptables -I DOCKER-USER -d 169.254.169.254/32 -j DROP'
UNIT
systemctl daemon-reload
systemctl enable ecs
systemctl start ecs --no-block
